{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Montai",
  "version": "1.2.0",
  "identifier": "com.montai.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/create-out.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Montai",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "url": "https://montai-plum.vercel.app",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 Montai/1.2.0",
        "backgroundColor": [7, 8, 13, 255],
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "title": "Montai"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Your AI video editing mentor",
    "longDescription": "Montai is an AI-powered video editing mentor. Ask questions about color grading, cuts, audio mixing, storytelling, and more.",
    "publisher": "Montai",
    "copyright": "Copyright © 2026 Montai",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "clipboard-manager": {},
    "notification": {},
    "dialog": {},
    "fs": {
      "scope": ["$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**", "$TEMP/**"]
    },
    "shell": {
      "open": true
    }
  }
}
