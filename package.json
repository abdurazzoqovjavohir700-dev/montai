{
  "name": "montai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "next build && next export",
    "start": "next start",
    "lint": "eslint",
    "cap:init": "npx cap init Montai com.montai.app --web-dir out",
    "cap:sync": "npm run build:static && npx cap sync android",
    "cap:android": "npx cap open android",
    "tauri": "tauri",
    "tauri:build": "npx tauri build",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:bundle": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "android:install": "cd android && ./gradlew installDebug",
    "tauri:dev": "npx tauri dev",
    "tauri:build:debug": "npx tauri build --debug",
    "tauri:install": "npm install --save-dev @tauri-apps/cli@latest",
    "build:all": "npm run build && npm run android:release && npm run tauri:build"
  },
  "dependencies": {
    "@auth/supabase-adapter": "^1.11.2",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.109.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "groq-sdk": "^1.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "next-pwa": "^5.6.0",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "netlify-cli": "^26.2.0",
    "picomatch": "^4.0.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "pdf-parse@2.4.5": true
  }
}
